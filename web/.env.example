# Copy this to .env.local and fill in real values.

# Mapbox GL requires a public access token.
# Sign up free at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_token_here

# Aleena's backend. Leave unset to use the built-in mock stream.
# VITE_BACKEND_URL=http://localhost:3000

# Force mock stream even if VITE_BACKEND_URL is set (useful for design work).
# VITE_USE_MOCK=1
